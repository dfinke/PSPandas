<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PSPandas.DataFrame</Name>
      <ViewSelectedBy>
        <TypeName>PSPandas.DataFrame</TypeName>
      </ViewSelectedBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding>
                <ScriptBlock><![CDATA[
$rows = @($_.Rows)
if ($rows.Count -eq 0) {
    'PSPandas.DataFrame (0 rows; columns: {0})' -f ($_.Columns -join ', ')
} elseif (@($_.PSTypeNames) -contains 'PSPandas.Profile') {
    $rows |
        Format-Table -Property Column, Type, RowCount, NullCount, DistinctCount, Minimum, Maximum, Average, Sum, SampleValues -AutoSize |
        Out-String -Width 300
} else {
    $rows | Format-Table -AutoSize | Out-String -Width 200
}
                ]]></ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
  </ViewDefinitions>
</Configuration>
